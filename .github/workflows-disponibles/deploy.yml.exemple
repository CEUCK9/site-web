name: Publication du site

# ---------------------------------------------------------------------------
# ACTIVATION (une seule fois)
#
#   1. Déplacer ce fichier vers .github/workflows/deploy.yml
#      (le pousser demande un jeton avec le droit « workflow » :
#       gh auth refresh -s workflow)
#
#   2. Renseigner les identifiants FTP de l'hébergement OVH dans
#      Settings → Secrets and variables → Actions → Secrets :
#
#        FTP_SERVER    ex. ftp.cluster0XX.hosting.ovh.net
#        FTP_USERNAME  identifiant FTP de l'hébergement
#        FTP_PASSWORD  mot de passe associé
#
#      Ces trois valeurs se trouvent dans l'espace client OVH, rubrique
#      Hébergements → FTP-SSH. Une fois enregistrées comme secrets, elles
#      ne sont plus lisibles, y compris par les administrateurs.
#
#   3. Facultatif, dans Variables (et non Secrets) :
#        FTP_DOSSIER   dossier cible sur le serveur (défaut : /www/)
#        CEUC_STAGING  1 = site interdit à l'indexation (défaut)
#                      0 = site public, référencé par Google
#
# ENSUITE
#
#   Chaque modification poussée sur `main` reconstruit le site et l'envoie
#   sur https://ceuc.fr — sans rien lancer à la main. C'est ce qui permet à
#   l'association de modifier son contenu depuis l'application Claude.
#
# GARDE-FOU
#
#   check.py s'exécute AVANT l'envoi. S'il trouve un lien mort, une balise
#   en double ou une image sans description, la publication échoue et le
#   site en ligne reste intact. Une erreur ne peut pas casser le site.
# ---------------------------------------------------------------------------

on:
  push:
    branches: [main]
  workflow_dispatch:

concurrency:
  group: publication
  cancel-in-progress: true

jobs:
  publier:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Installer Pillow (traitement des photos)
        run: pip install --quiet Pillow

      - name: Préparer les photos
        # Sans CEUC_SRC, seules les photos de assets/photos-2026 sont
        # régénérées : déposer une photo dans ce dossier et la déclarer dans
        # src/images.py suffit à la faire arriver sur le site.
        run: python3 src/images.py

      - name: Générer le site
        env:
          CEUC_BASE_URL: https://ceuc.fr
          CEUC_BASE_PATH: ""
          CEUC_STAGING: ${{ vars.CEUC_STAGING || '1' }}
        run: python3 build.py

      - name: Contrôler liens, SEO et structure
        run: python3 check.py

      - name: Envoyer sur l'hébergement OVH
        uses: SamKirkland/FTP-Deploy-Action@v4.3.5
        with:
          server: ${{ secrets.FTP_SERVER }}
          username: ${{ secrets.FTP_USERNAME }}
          password: ${{ secrets.FTP_PASSWORD }}
          protocol: ftps
          local-dir: ./dist/
          server-dir: ${{ vars.FTP_DOSSIER || '/www/' }}
          # L'action garde la trace de ce qui a déjà été envoyé et ne
          # transfère que les fichiers modifiés : une correction de texte
          # ne réenvoie pas les 90 images du site.
          state-name: .ftp-deploy-sync-state.json
          exclude: |
            **/.git*
            **/.git*/**
