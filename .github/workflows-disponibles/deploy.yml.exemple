name: Déploiement GitHub Pages

# Version de relecture pour l'association : reconstruite à chaque push sur main.
# L'indexation est bloquée (CEUC_STAGING) pour qu'elle ne concurrence pas le
# futur site sur le domaine définitif.

on:
  push:
    branches: [main]
  workflow_dispatch:

permissions:
  contents: read
  pages: write
  id-token: write

concurrency:
  group: pages
  cancel-in-progress: true

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Générer le site
        env:
          CEUC_BASE_URL: https://avtplay.github.io
          CEUC_BASE_PATH: /ceuc
          CEUC_STAGING: "1"
        run: python3 build.py

      - name: Contrôler liens et SEO
        env:
          CEUC_BASE_PATH: /ceuc
        run: python3 check.py

      - uses: actions/configure-pages@v5

      - uses: actions/upload-pages-artifact@v3
        with:
          path: dist

  deploy:
    needs: build
    runs-on: ubuntu-latest
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    steps:
      - id: deployment
        uses: actions/deploy-pages@v4
